NODE_ENV=production
JUICED_SERVICE_URL=https://juiced.codes
# Optional CLI product analytics. Empty key disables collection entirely.
# Use the project's public ingestion key, never a personal API key.
JUICED_POSTHOG_KEY=
JUICED_POSTHOG_HOST=https://us.i.posthog.com
# EU projects use https://eu.i.posthog.com
# Optional public verification tokens. These are embedded in HTML at build time.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
JUICED_DATABASE_URL=
JUICED_WORKER_DATABASE_URL=
JUICED_AUTH_SECRET=
# Vercel Cron supplies this as its Authorization bearer token.
CRON_SECRET=
# Versioned encryption keys can use Better Auth's BETTER_AUTH_SECRETS.
JUICED_GITHUB_CLIENT_ID=
JUICED_GITHUB_CLIENT_SECRET=
JUICED_GOOGLE_CLIENT_ID=
JUICED_GOOGLE_CLIENT_SECRET=
JUICED_ADMISSION_ENABLED=false
# Private CLI-generated integration JSON with api and worker profiles.
# Both bind juiced to the same Fleet/package/runtime; use separate scoped principals.
# API: installations:read, credentials:read
# Worker: installations:read/write, credentials:read, policy:write
CANTELOP_APP_CONFIG=
CANTELOP_API_PROFILE=api
CANTELOP_WORKER_PROFILE=worker
JUICED_MINIMUM_CLI=0.2.0
# Published CLI matching the approved package/runtime. Defaults to the source version.
JUICED_CLI_VERSION=0.2.3
# Optional. Leave STRIPE_SECRET_KEY empty to disable billing; accounts use the
# default free allowance. When set, every STRIPE_* value is required.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
JUICED_INCLUDED_CREDITS=
