{
  "name": "juiced",
  "version": "0.2.5",
  "description": "Run Claude Code on Cantelop from your terminal",
  "type": "module",
  "private": false,
  "bin": {
    "juiced": "bin/juiced.mjs"
  },
  "files": [
    "bin",
    "dist/cli.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:installer": "node scripts/test-installer.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --import ./test/self-managed-fixtures.ts --test --test-concurrency=4 test/*.test.ts",
    "test:serial": "node --import tsx --import ./test/self-managed-fixtures.ts --test --test-concurrency=1 test/*.test.ts",
    "test:environment:local": "npm run build && JUICED_MODE=self-managed node scripts/test-environment-local.mjs",
    "test:live": "JUICED_MODE=self-managed node scripts/test-live.mjs",
    "test:agent:live": "JUICED_MODE=self-managed node scripts/test-agent-live.mjs",
    "measure:latency": "node scripts/measure-terminal-latency.mjs",
    "probe:reconciliation": "node scripts/probe-cantelop-reconciliation.mjs",
    "prepack": "npm run build",
    "test:git:live": "JUICED_MODE=self-managed node scripts/test-git-live.mjs",
    "test:delete:local": "npm run build && JUICED_MODE=self-managed node scripts/test-delete-local.mjs",
    "test:delete:live": "npm run build && JUICED_MODE=self-managed node scripts/test-delete-live.mjs",
    "test:inspection:local": "npm run build && npm run build:runtime && JUICED_MODE=self-managed node --import tsx scripts/test-inspection-local.mjs",
    "check:service": "npm run check --workspace @juiced/service",
    "test:service": "npm test --workspace @juiced/service",
    "migrate:service": "node --import tsx service/src/migrate.ts",
    "start:service": "npm run start --workspace @juiced/service",
    "check:package": "npm run build && node scripts/smoke-install.mjs",
    "build:service": "npm run build --workspace @juiced/service",
    "dev:service": "npm run dev --workspace @juiced/service"
  },
  "dependencies": {
    "@cantelop/sdk": "1.5.1",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "service"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepandel/juiced.git"
  }
}
