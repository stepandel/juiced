{
  "name": "juiced",
  "version": "0.1.0",
  "description": "Run Claude Code on Cantelop from your terminal",
  "type": "module",
  "private": true,
  "bin": {
    "juiced": "bin/juiced.mjs"
  },
  "files": [
    "bin",
    "dist/cli.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node scripts/test-live.mjs",
    "test:agent:live": "node scripts/test-agent-live.mjs",
    "measure:latency": "node scripts/measure-terminal-latency.mjs",
    "probe:reconciliation": "node scripts/probe-cantelop-reconciliation.mjs",
    "prepack": "npm run build",
    "test:sync:live": "node scripts/test-sync-live.mjs"
  },
  "dependencies": {
    "@cantelop/sdk": "1.2.0",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
